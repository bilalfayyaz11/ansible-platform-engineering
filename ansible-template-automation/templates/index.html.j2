<!DOCTYPE html>
<html>
<head>
    <title>{{ app_name }}</title>
</head>
<body>

<h1>{{ app_name }}</h1>

<p><strong>Version:</strong> {{ app_version }}</p>
<p><strong>Environment:</strong> {{ app_environment }}</p>

<h2>Server Information</h2>

<ul>
<li>Hostname: {{ ansible_hostname }}</li>
<li>Operating System: {{ ansible_distribution }} {{ ansible_distribution_version }}</li>
<li>Architecture: {{ ansible_architecture }}</li>
<li>Memory: {{ ansible_memtotal_mb }} MB</li>
</ul>

<h2>Enabled Modules</h2>

<ul>
{% for module in enabled_modules %}
<li>{{ module }}</li>
{% endfor %}
</ul>

<p>Generated: {{ ansible_date_time.iso8601 }}</p>

</body>
</html>
